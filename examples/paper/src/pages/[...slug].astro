---
import { getCollection, render } from 'astro:content';
import Article from '../layouts/Article.astro';

export async function getStaticPaths() {
  const pages = (await getCollection('paper')).sort((a, b) => a.data.order - b.data.order);
  return pages.map((page) => ({ params: { slug: page.data.path || undefined }, props: { page, pages } }));
}

const { page, pages } = Astro.props;
const { Content } = await render(page);
---

<Article page={page} pages={pages}>
  <Content />
</Article>
