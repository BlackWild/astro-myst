---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const nav = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
  return nav.map((page) => ({ params: { slug: page.data.path || undefined }, props: { page, nav } }));
}

const { page, nav } = Astro.props;
const { Content, headings } = await render(page);
---

<DocsLayout page={page} nav={nav} headings={headings}>
  <Content />
</DocsLayout>
